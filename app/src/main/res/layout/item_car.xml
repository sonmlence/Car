<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<TextView
    android:layout_marginTop="6dp"
    android:layout_marginStart="10dp"
    android:id="@+id/tv_camry"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Toyota Camry 50"
    android:textStyle="bold"
    android:textColor="@color/blue"
    android:textSize="22sp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    />


    <TextView
        android:layout_marginTop="6dp"
        android:id="@+id/tv_price"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="20dp"
        android:textSize="22sp"
        android:textColor="@color/black"
        android:text="$75/day"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


    <ImageView
        android:layout_marginTop="8dp"
        android:id="@+id/img_car"
        android:layout_marginStart="20dp"
app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_camry"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_launcher_background"
        />

    <ImageView
        android:id="@+id/ic_car"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_car"
        app:layout_constraintStart_toEndOf="@id/img_car"
        app:layout_constraintTop_toBottomOf="@id/tv_camry"
        app:tint="@color/blue" />


    <TextView
        android:id="@+id/tv_class_car"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Luxury"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/ic_car"
        app:layout_constraintTop_toTopOf="@+id/ic_car"
        android:layout_marginStart="4dp"
        />

    <ImageView
        android:layout_marginTop="4dp"
        app:tint="@color/blue"
        android:id="@+id/ic_transmission"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/ic_car"
        android:src="@drawable/ic_transmission"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintStart_toEndOf="@id/img_car"/>


    <TextView
        android:id="@+id/tv_transmission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Automatic Transmission"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/ic_transmission"
        app:layout_constraintTop_toBottomOf="@id/tv_class_car" />

    <ImageView
        android:id="@+id/ic_freeze"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/ic_transmission"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_freeze"
        app:tint="@color/blue"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:layout_constraintStart_toEndOf="@id/img_car"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="Yes"
        app:layout_constraintStart_toEndOf="@id/ic_freeze"
        app:layout_constraintTop_toBottomOf="@id/tv_transmission" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/ic_freeze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>