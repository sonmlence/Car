<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.car.ui.main.MainFragment"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_detailCarFragment"
            app:destination="@id/detailCarFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailCarFragment"
        android:name="com.example.car.ui.detail.DetailCarFragment"
        tools:layout="@layout/fragment_detail_car">
        <argument
            android:name="carModel"
            app:argType="com.example.car.data.models.CarModel" />
    </fragment>

    <fragment
        android:id="@+id/onBoardFragment"
        android:name="com.example.car.ui.on_board.OnBoardFragment"
        tools:layout="@layout/fragment_on_board">
        <action
            android:id="@+id/action_onBoardFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>

</navigation>
